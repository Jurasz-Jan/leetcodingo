# Skopiuj ten plik jako `keystore.properties` obok `settings.gradle.kts`
# i uzupełnij hasłami. Plik `keystore.properties` jest w `.gitignore`
# i nigdy nie może trafić do repozytorium.
#
# Bez tego pliku build `release` nadal się powiedzie, ale zostanie podpisany
# kluczem debugowym i wypisze ostrzeżenie. Takie APK nadaje się do sprawdzenia
# u siebie, nie do rozdawania.
#
# Zamiast pliku można ustawić zmienne środowiskowe o tych samych wartościach:
# LEETCODINGO_KEYSTORE, LEETCODINGO_STORE_PASSWORD,
# LEETCODINGO_KEY_ALIAS, LEETCODINGO_KEY_PASSWORD.
# Tak działa to w CI, gdzie klucz przychodzi z sekretów repozytorium.

storeFile=C:/dev/leetcodingo-release.jks
storePassword=
keyAlias=leetcodingo
keyPassword=
